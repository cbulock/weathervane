# Weather location (city name, e.g. "New York", "London")
# Leave empty to use browser geolocation (unreliable in Docker)
LOCATION=

# Display settings
SCREEN_WIDTH=960
SCREEN_HEIGHT=720
FRAMERATE=30

# Capture area within the X display. Defaults crop away browser chrome/unused gutter.
CAPTURE_WIDTH=930
CAPTURE_HEIGHT=600
CAPTURE_OFFSET_X=15
CAPTURE_OFFSET_Y=0

# Encoding settings
VIDEO_BITRATE=2500k
AUDIO_BITRATE=128k
FFMPEG_PRESET=veryfast

# HLS settings
HLS_SEGMENT_DURATION=4
HLS_LIST_SIZE=5
HLS_PORT=8080

# Timezone (affects weather display)
TZ=America/New_York

# Debug: enable VNC on port 5900 to see the browser
ENABLE_VNC=false
