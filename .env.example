# Weather location (city name, e.g. "New York", "London")
# Leave empty to use browser geolocation (unreliable in Docker)
LOCATION=

# Display settings
SCREEN_WIDTH=960
SCREEN_HEIGHT=720
CAPTURE_MODE=full
FRAMERATE=30

# Capture area within the X display. Only used when CAPTURE_MODE=crop.
CAPTURE_WIDTH=960
CAPTURE_HEIGHT=720
CAPTURE_OFFSET_X=0
CAPTURE_OFFSET_Y=0

# Debug: write framing screenshots and metrics into FRAMING_DEBUG_DIR.
FRAMING_DEBUG=false
FRAMING_DEBUG_DIR=/tmp/hls/debug

# Encoding settings
VIDEO_BITRATE=2500k
AUDIO_BITRATE=128k
FFMPEG_PRESET=veryfast

# HLS settings
HLS_SEGMENT_DURATION=4
HLS_LIST_SIZE=5
HLS_PORT=8080

# XMLTV / EPG settings
EPG_CHANNEL_ID=weathervane.retro
EPG_CHANNEL_NAME=WeatherVane RetroCast
EPG_CHANNEL_ICON=https://weather.com/retro/assets/icon.png
EPG_PROGRAM_TITLE=RetroCast Weather Loop
EPG_PROGRAM_DESCRIPTION=Continuous Weather Channel RetroCast stream.

# Timezone (affects weather display)
TZ=America/New_York

# Debug: enable VNC on port 5900 to see the browser
ENABLE_VNC=false
